DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
APP_URL=http://localhost:3000
# Пакет арендатора из tenants/<slug>/. Пусто — по Host, а локально — первый пакет.
TENANT=
# Администратор ADMIN_* действует при TENANT=<slug> или SUPERADMIN=true (без TENANT, при нескольких пакетах); логины клиентов — npm run quiz:admin.
# SUPERADMIN=true
# Адвент с погашением на кассе: подпись личного QR, не короче 32 символов (openssl rand -hex 32). В production обязательна; вне production — запасной ключ разработки.
# REWARD_QR_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Holiday Quiz <quiz@example.com>
ADMIN_USERNAME=operator
ADMIN_PASSWORD=replace-with-a-long-random-password
# Необязательная SMTP-авторизация (обе переменные вместе)
# SMTP_USER=
# SMTP_PASSWORD=
# Закрытый стенд: Basic auth на весь сайт (кроме /api/health и /api/admin/*); обе вместе, пароль >= 16 символов.
# В production с публичным APP_URL именно они разрешают QUIZ_FORCE_OPEN. Боевой запуск на облачной ВМ — deploy/README.md.
# STAGING_USERNAME=preview
# STAGING_PASSWORD=replace-with-a-long-random-password
# Только для npm run test:integration; имя базы должно начинаться с "test_" или оканчиваться на "_test"
# TEST_DATABASE_URL=postgresql://quiz:quiz-local-only@127.0.0.1:5432/quiz_test

{
  "name": "holiday-quiz-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:tenants": "node scripts/e2e-tenants.mjs",
    "test:e2e:advent": "node scripts/e2e-advent.mjs",
    "test:load": "tsx scripts/load-smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "cleanup:pii": "tsx scripts/cleanup-pii.ts",
    "advent:remind": "tsx scripts/advent-remind.ts",
    "quiz:new": "tsx scripts/quiz-new.ts",
    "quiz:check": "tsx scripts/quiz-check.ts",
    "quiz:rules": "tsx scripts/quiz-rules.ts",
    "quiz:shots": "tsx scripts/quiz-shots.ts",
    "advent:shots": "tsx scripts/advent-shots.ts",
    "quiz:brand": "tsx scripts/quiz-brand.ts",
    "quiz:admin": "tsx scripts/quiz-admin.ts",
    "quiz:preview": "tsx scripts/quiz-preview.ts",
    "quiz:export": "tsx scripts/quiz-export.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.8",
    "motion": "14.2.0",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}

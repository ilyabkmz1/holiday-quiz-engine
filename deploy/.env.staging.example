# Шаблон .env для режима STAGING (показ до старта кампании 20.12).
# Рабочий файл живёт ТОЛЬКО на ВМ: /opt/quiz/.env (создаёт deploy/generate-secrets.sh staging).
# Значения CHANGE_ME_* скрипт заменяет случайными. Файл с секретами НЕЛЬЗЯ коммитить.
# Формат: KEY=value, без кавычек и без пробелов вокруг «=». Подстановка ${VAR} допустима только в
# DATABASE_URL (её делает docker compose); остальные значения задавайте литералами.

# --- Режим -------------------------------------------------------------------
# Включает контейнер Mailpit (перехватывает письма). В боевом режиме строка пустая/отсутствует.
COMPOSE_PROFILES=staging

# --- Домен и TLS -------------------------------------------------------------
# Доменное имя игры; A-запись должна указывать на floating IP ВМ.
DOMAIN=quiz.example.com
# Email для уведомлений Let's Encrypt (об истечении сертификата). Обязателен.
ACME_EMAIL=ops@example.com
# Публичный адрес сайта, ВСЕГДА https://<DOMAIN> (скрипты это проверяют). По нему проверяется Origin
# мутирующих запросов (иначе игра отвечает 403) и строятся ссылки и редиректы.
# Литерал, не ${DOMAIN}: скрипты читают .env без подстановки. Реальный домен подставляет
# generate-secrets.sh --domain ... (или generate-secrets.sh --set-domain ...).
APP_URL=https://quiz.example.com
# Пакет арендатора из tenants/ (slug папки).
TENANT=demo-office
# Пакеты в образе (аргумент сборки): по умолчанию = TENANT, чтобы демо и чужие клиенты не попадали в боевой образ.
# Общий сервер: TENANT= (пусто), TENANT_BASE_DOMAIN=quiz.studio.ru, QUIZ_PACKS=all (или slug1,slug2), CADDYFILE=./Caddyfile.shared,
# TLS_ASK_TOKEN=<openssl rand -hex 24>, при необходимости SUPERADMIN=true (см. deploy/README.md, раздел 16).
# QUIZ_PACKS=demo-office
# Адвент с погашением на кассе: подпись личного QR (в production обязательна), REWARD_QR_SECRET=<openssl rand -hex 32>.
# REWARD_QR_SECRET=

# --- PostgreSQL --------------------------------------------------------------
# Пароль БД (генерирует generate-secrets.sh). Порт БД наружу не публикуется.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# Адрес БД для приложения: сервис db внутри сети Compose. Обычно не менять.
DATABASE_URL=postgresql://quiz:${POSTGRES_PASSWORD}@db:5432/quiz?schema=public

# --- Почта: в staging письма уходят в Mailpit --------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
# true — неявный TLS (обычно порт 465). Для порта 587 (STARTTLS) оставьте false.
SMTP_SECURE=false
SMTP_FROM=Holiday Quiz <quiz@example.com>
# SMTP_USER / SMTP_PASSWORD в staging не нужны (Mailpit без авторизации).

# --- Операторский доступ (/api/admin/*) --------------------------------------
# Собственная Basic auth админских endpoint'ов. Не путать со STAGING_*.
ADMIN_USERNAME=operator
# Не короче 16 символов (генерирует generate-secrets.sh).
ADMIN_PASSWORD=CHANGE_ME_ADMIN

# --- Закрытый стенд (HTTP Basic auth на весь сайт, кроме /api/health и /api/admin/*) ---
STAGING_USERNAME=preview
# Не короче 16 символов (генерирует generate-secrets.sh). Передайте тем, кто смотрит стенд.
STAGING_PASSWORD=CHANGE_ME_STAGING

# --- Обход дат кампании ------------------------------------------------------
# true — квиз и заявки открыты вне 20.12–02.01. В production приложение разрешает флаг
# ТОЛЬКО при заданных STAGING_USERNAME и STAGING_PASSWORD; иначе откажется стартовать.
QUIZ_FORCE_OPEN=true

# --- Необязательные -----------------------------------------------------------
# Каталог дампов на ВМ (по умолчанию /opt/quiz/backups) и срок хранения в днях.
# BACKUP_DIR=/opt/quiz/backups
# BACKUP_RETENTION_DAYS=14
# Час ежедневного дампа по UTC (0 = 03:00 МСК).
# BACKUP_HOUR_UTC=0

# Reverse proxy с автоматическим TLS (Let's Encrypt). Значения приходят из deploy/compose.yml.
{
	email {$ACME_EMAIL}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	reverse_proxy app:3000 {
		# При сбое во время перезапуска app даём 5 секунд на возврат, а не сразу 502.
		lb_try_duration 5s
		lb_try_interval 500ms
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Токен подтверждения заявки не должен попадать в журналы.
				request>uri query {
					delete token
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				# IP игроков в журналы доступа не пишем (персональные данные).
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
}

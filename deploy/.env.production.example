# Шаблон .env для БОЕВОГО режима (с 20.12). Отличия от staging: нет Basic auth, нет force-open,
# настоящий SMTP, Mailpit не запускается.
# Рабочий файл живёт ТОЛЬКО на ВМ: /opt/quiz/.env (создаёт deploy/generate-secrets.sh production).
# Файл с секретами НЕЛЬЗЯ коммитить.
# Формат: KEY=value, без кавычек и без пробелов вокруг «=». Подстановка ${VAR} допустима только в
# DATABASE_URL (её делает docker compose); остальные значения задавайте литералами.

# --- Режим -------------------------------------------------------------------
# Профиль staging (Mailpit) в боевом режиме НЕ включается.
COMPOSE_PROFILES=

# --- Домен и TLS -------------------------------------------------------------
# Доменное имя игры; A-запись должна указывать на floating IP ВМ.
DOMAIN=quiz.example.com
# Email для уведомлений Let's Encrypt. Обязателен.
ACME_EMAIL=ops@example.com
# Публичный адрес сайта, ВСЕГДА https://<DOMAIN> (скрипты это проверяют). Литерал, не ${DOMAIN}:
# скрипты читают .env без подстановки. Домен подставляет generate-secrets.sh --domain ...
APP_URL=https://quiz.example.com
# Пакет арендатора из tenants/ (slug папки).
TENANT=demo-office
# Пакеты в образе (аргумент сборки): по умолчанию = TENANT, чтобы демо и чужие клиенты не попадали в боевой образ.
# Общий сервер: TENANT= (пусто), TENANT_BASE_DOMAIN=quiz.studio.ru, QUIZ_PACKS=all (или slug1,slug2), CADDYFILE=./Caddyfile.shared,
# TLS_ASK_TOKEN=<openssl rand -hex 24>, при необходимости SUPERADMIN=true (см. deploy/README.md, раздел 16).
# QUIZ_PACKS=demo-office
# Адвент с погашением на кассе: подпись личного QR (в production обязательна), REWARD_QR_SECRET=<openssl rand -hex 32>.
# REWARD_QR_SECRET=
# Напоминания адвента (сервис reminders, см. deploy/README.md, раздел 12); значения по умолчанию подходят, менять при необходимости:
# REMINDERS_INTERVAL_SECONDS=900
# REMINDER_RATE_PER_SECOND=5
# REMINDER_MAX_ATTEMPTS=3
# REMINDER_MAX_LATE_HOURS=6
# Демо-пакеты писем не шлют; true разрешает (только staging):
# ADVENT_REMINDERS_DEMO=false

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
DATABASE_URL=postgresql://quiz:${POSTGRES_PASSWORD}@db:5432/quiz?schema=public

# --- Почта: настоящий SMTP (данные у владельца кампании) --------------------------
SMTP_HOST=smtp.example.com
# 587 — STARTTLS (SMTP_SECURE=false), 465 — неявный TLS (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
# Адрес отправителя; домен должен иметь SPF/DKIM, иначе письма уйдут в спам.
SMTP_FROM=Holiday Quiz <quiz@example.com>
# Авторизация SMTP: обе переменные вместе или обе пустые.
# SMTP без авторизации (relay во внутренней сети): оставьте ОБЕ строки ниже пустыми
# (SMTP_USER= и SMTP_PASSWORD= без значений), иначе deploy.sh остановится на CHANGE_ME_*.
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# --- Операторский доступ (/api/admin/*) --------------------------------------
ADMIN_USERNAME=operator
# Не короче 16 символов (генерирует generate-secrets.sh).
ADMIN_PASSWORD=CHANGE_ME_ADMIN

# --- Закрытый стенд: в боевом режиме НЕ задавать -----------------------------
# STAGING_USERNAME=
# STAGING_PASSWORD=

# --- Обход дат кампании: в боевом режиме ЗАПРЕЩЁН ----------------------------
QUIZ_FORCE_OPEN=false

# --- Необязательные -----------------------------------------------------------
# BACKUP_DIR=/opt/quiz/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=0
